{
  "name": "macsa-api",
  "version": "1.0.0",
  "description": "API REST del CMMS de Grupo Macsa - consume exclusivamente stored procedures de MacsaCMMS",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "prod": "pm2 start src/server.js --name macsa-api --node-args=\"--env-file=.env\"",
    "prod:stop": "pm2 stop macsa-api",
    "prod:restart": "pm2 restart macsa-api",
    "prod:logs": "pm2 logs macsa-api",
    "prod:status": "pm2 status"
  },
  "keywords": [
    "cmms",
    "macsa",
    "express"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mssql": "^12.7.0",
    "multer": "^2.4.0",
    "pm2": "^7.0.4"
  }
}
